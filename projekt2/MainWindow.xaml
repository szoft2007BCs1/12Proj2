<Window x:Class="projekt2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projekt2"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ComboBox HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Width="250" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" x:Name="ComboBox_mindenes" SelectionChanged="ComboBox_mindenes_SelectionChanged">

        </ComboBox>
        <TextBox x:Name="txtblock_id" Grid.Row="1" IsEnabled="False" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtblock_name" Grid.Row="2" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtblock_phone" Grid.Row="3" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtblock_street" Grid.Row="4" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtblock_restaurant" Grid.Row="5" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtblock_time" Grid.Row="6" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        
        <CheckBox x:Name="chckbox_status" Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="250 0 0 0"/>
        <Label Content="Új rendelés?" Grid.Row="7" FontSize="30" Margin="300 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <ComboBox x:Name="ComboBox_method" Grid.Row="8" HorizontalAlignment="Center" VerticalAlignment="Center" Height="25" Width="250" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
            <ComboBoxItem Content="Online"/>
            <ComboBoxItem Content="Cash"/>
            <ComboBoxItem Content="Card"/>

        </ComboBox>
        <TextBox x:Name="txtblock_price" Grid.Row="9" Text="Szöveg" FontSize="30" Width="500" Height="75" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

        <Button x:Name="btn_add" Content="Új rendelés felvétele" Grid.Row="10" Height="75" Width="250" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btn_add_Click"/>

        <Label Grid.Column="1" Content="Statisztika" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lbl_ossz" Grid.Column="1" Grid.Row="1" Content="Össz rendelések száma:" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Column="1" Grid.Row="2" Content="Legnagyobb rendelés:" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Label x:Name="lbl_maxar" Grid.Column="1" Grid.Row="3" Content="Szöveg" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Label Grid.Column="1" Grid.Row="4" Content="Legalacsonabb rendelés:" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Label x:Name="lbl_minar" Grid.Column="1" Grid.Row="5" Content="Szöveg" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Label Grid.Column="1" Grid.Row="6" Content="Első mai rendelés:" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Label x:Name="lbl_mai" Grid.Column="1" Grid.Row="7" Content="Nincs" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>


        <ComboBox HorizontalAlignment="Center" VerticalAlignment="Center" Height="75" Width="350" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" x:Name="ComboBox_torles" Grid.Column="2" Grid.RowSpan="2" FontSize="20">

        </ComboBox>
        <Button x:Name="btn_remove" Content="Rendelés törlése" Grid.Row="2" Grid.Column="2" Height="75" Width="250" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btn_remove_Click"/>
    </Grid>
</Window>
